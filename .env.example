# Example Environment Variables

# --- Application Core ---
# Generate a strong secret key, e.g., using: openssl rand -hex 32
SECRET_KEY="your_super_secret_key_for_fastapi_jwt"
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# ALGORITHM="HS256"

# --- Database ---
# Ensure this matches the database created for the application (app_db)
# For local development:
DATABASE_URL="postgresql://app_user:app_user_password@localhost:5432/app_db"
# For Fly.io or other hosted DB, this will be provided by the service

# --- IGA Engine (midPoint/Syncope) ---
# Replace with your actual IGA engine's API endpoint and credentials
# IGA_API_URL="http://localhost:8080/midpoint"
# IGA_API_KEY="administrator:5ecr3t" # For midPoint basic auth (example only!)
# IGA_API_URL="http://localhost:9080/syncope/rest"
# IGA_API_KEY="syncope_admin_username:syncope_admin_password" # For Syncope (example only!)

# --- PAM Engine (JumpServer/Teleport) ---
# Replace with your actual PAM engine's API endpoint and credentials
# PAM_API_URL="http://localhost:8080/api/v1" # JumpServer API often at /api/v1
# PAM_API_TOKEN="your_jumpserver_api_token"
# PAM_API_URL="http://teleport_auth_server_ip:3080" # Teleport Proxy
# PAM_API_TOKEN="teleport_auth_token_if_needed_for_api" # Teleport might use other auth methods

# --- CORS Origins (if needed, comma-separated, no spaces) ---
# BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,https://your.frontend.domain"
